{
  "functions": {
    "research-app/main.py": {
      "excludeFiles": [
        "**/onnxruntime/**",
        "**/*.onnx",
        "**/*.bin"
      ]
    }
  },
  "builds": [
    {
      "src": "research-app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "research-app/main.py"
    }
  ]
}
